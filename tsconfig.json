{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./types",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "module": "nodenext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "/**/*",
  ],
  "exclude": [
    "node_modules/**/**",
    ".pnpm",
    "**/*.test.js",
    "types",
    "kogiqa-extracted",
  ]
}
